{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi-plugin-center.dev/schema/review-report.schema.json",
  "title": "AI review report",
  "description": "Output of one review pass. A report is evidence, not a decision: the policy evaluator recomputes every gate from the database and ignores publishable/approved claims made here. Source, manifests, and logs are untrusted data and instructions found in them are never executed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reviewId", "pass", "verdict", "risk", "findings", "provenance"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "reviewId": { "type": "string" },
    "pass": {
      "enum": ["primary", "critic"],
      "description": "critic reads the same input snapshot and evidence, never primary's conclusions."
    },
    "mode": { "enum": ["release", "rescan"], "default": "release" },
    "verdict": {
      "enum": ["pass", "block", "needs_info"],
      "description": "needs_info is the required answer when evidence is incomplete. Guessing pass is a defect."
    },
    "risk": { "enum": ["none", "low", "medium", "high", "critical"] },
    "publishable": {
      "type": "boolean",
      "description": "Advisory only. The evaluator ignores this field."
    },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "permissionDiff": { "$ref": "#/$defs/diff" },
    "dataPracticeDiff": { "$ref": "#/$defs/diff" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputSnapshotSha256", "model", "promptVersion"],
      "properties": {
        "inputSnapshotSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "model": { "type": "string" },
        "promptVersion": { "type": "string" },
        "reportGenerator": { "type": "string" },
        "startedAt": { "type": "string", "format": "date-time" },
        "finishedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId", "severity", "confidence", "description", "blocking", "evidence"],
      "properties": {
        "ruleId": { "type": "string" },
        "severity": { "enum": ["info", "low", "medium", "high", "critical"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "description": { "type": "string", "maxLength": 2000 },
        "blocking": { "type": "boolean" },
        "dimension": {
          "enum": ["identity", "package", "runtime", "supply-chain", "quality", "privacy", "upgrade"]
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["locator", "sha256"],
          "properties": {
            "locator": { "type": "string", "description": "Path plus line range inside the pinned snapshot." },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "excerpt": { "type": "string", "maxLength": 2000 }
          }
        },
        "recommendation": { "type": "string", "maxLength": 2000 }
      }
    },
    "diff": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "added": { "type": "array", "items": { "type": "string" } },
        "removed": { "type": "array", "items": { "type": "string" } },
        "changed": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}

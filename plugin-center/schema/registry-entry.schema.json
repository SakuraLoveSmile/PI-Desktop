{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi-plugin-center.dev/schema/registry-entry.schema.json",
  "title": "Plugin registry entry",
  "description": "The Git-tracked projection of one plugin's published state. Written by the center's publish step inside the publish transaction, never edited by a publisher directly. This file is the append-only witness that makes a replaced release asset detectable.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "pluginId", "publisherId", "name", "description", "author", "repository", "releases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "pluginId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*\\.[a-z0-9][a-z0-9-]*$",
      "description": "Globally unique and never reused. Must equal manifest.id in the packaged plugin."
    },
    "publisherId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "trust": {
      "enum": ["verified", "community"],
      "default": "community",
      "description": "Issued by the center. A publisher cannot set this; the submission pipeline overwrites whatever arrives."
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 60 },
    "description": { "type": "string", "minLength": 1, "maxLength": 300 },
    "author": { "type": "string", "minLength": 1 },
    "categories": { "type": "array", "items": { "type": "string" }, "maxItems": 6 },
    "homepage": { "type": "string", "format": "uri", "pattern": "^https://" },
    "repository": {
      "type": "string",
      "pattern": "^https://[^\\s?#@]+$",
      "description": "Canonical HTTPS URL of the publisher's own repository. Source of truth for the plugin."
    },
    "readmeMarkdown": { "type": "string", "maxLength": 200000 },
    "safetyNotes": { "type": "string", "maxLength": 4000 },
    "releases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/release" }
    }
  },
  "$defs": {
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "publishedAt", "permissions", "provenance"],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "channel": { "enum": ["stable", "beta"], "default": "stable" },
        "publishedAt": { "type": "string", "format": "date-time" },
        "changelog": { "type": "string", "maxLength": 4000 },
        "minPiDesktop": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Plain version, not a range. The client refuses an install below this and ignores anything it cannot parse."
        },
        "permissions": { "type": "array", "items": { "type": "string" } },
        "fs": { "type": "object", "description": "manifest.fs, passed through so the client can show declared file scope." },
        "artifact": { "$ref": "#/$defs/artifact" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "review": { "$ref": "#/$defs/review" },
        "signature": { "type": "string" },
        "signatureAlg": { "const": "ed25519" },
        "keyId": { "type": "string" },
        "yanked": { "type": "boolean", "default": false },
        "yankedReason": { "type": "string", "maxLength": 500 },
        "yankedAt": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        {
          "description": "A live release must carry the artifact a client downloads; a withdrawn one must carry the reason a user reads.",
          "if": { "properties": { "yanked": { "const": true } }, "required": ["yanked"] },
          "then": { "required": ["yankedReason"] },
          "else": { "required": ["artifact"] }
        }
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "sha256", "sizeBytes"],
      "properties": {
        "fileName": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._@-]*\\.piplug$" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 52428800 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceRepository", "sourceCommit"],
      "properties": {
        "sourceRepository": { "type": "string", "pattern": "^https://[^\\s?#@]+$" },
        "sourceRef": { "type": "string" },
        "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "sourcePath": { "type": "string", "default": "." },
        "builder": { "type": "string" },
        "builtAt": { "type": "string", "format": "date-time" }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "risk", "policyVersion"],
      "properties": {
        "decision": { "enum": ["approved"] },
        "risk": { "enum": ["none", "low", "medium", "high", "critical"] },
        "policyVersion": { "type": "string" },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "reportUrl": { "type": "string", "format": "uri" }
      }
    }
  }
}

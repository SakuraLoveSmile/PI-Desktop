{
  "schemaVersion": 1,
  "id": "demo.ui-slots",
  "name": "UI Slots Demo",
  "version": "0.1.0",
  "description": "PI-Desktop 示例插件：一次性注册全部 UI 插槽（动作栏 / 回复追加区 / 工具卡 / 代码块渲染器 / 输入区）+ 自绘弹窗样本",
  "author": "PI-Desktop",
  "main": "main.js",
  "renderer": "renderer/index.mjs",
  "rendererActions": ["plugin.call", "composer.insertText", "composer.acceptTriggerItem"],
  "rendererCallMethods": ["stats.summary"],
  "contributes": {
    "agentTools": [
      {
        "name": "slot_demo_stats",
        "description": "Return fake usage stats for the toolCard demo",
        "risk": "low",
        "schema": {
          "type": "object",
          "properties": {
            "query": { "type": "string" }
          }
        }
      }
    ]
  },
  "permissions": [
    "renderer.extension",
    "agent.tool.register"
  ],
  "engines": {
    "piDesktop": ">=0.1.0"
  },
  "activationEvents": [
    "onStartup"
  ]
}
